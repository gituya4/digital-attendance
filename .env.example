FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration (Aiven)
DB_HOST=attendance-db-attendku.h.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password-here
DB_NAME=defaultdb
DB_PORT=12939

# Database SSL Configuration (for Aiven/cloud databases)
DB_SSL=true
DB_SSL_CA=ca.pem
DB_SSL_CERT=
DB_SSL_KEY=

# JWT Configuration (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# HMAC Configuration for QR signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
HMAC_SECRET_KEY=your-super-secret-hmac-key-change-in-production

# Email Configuration (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Application Configuration
APP_NAME=Digital Attendance System
APP_DOMAIN=your-domain.com
PREFERRED_URL_SCHEME=https
